# Root environment — used by docker-compose and Render blueprint.
# This file is a template for the *user* of the generated MVP; copy to .env
# and fill values. Every variable has a placeholder default.

APP_NAME=subtrack
APP_TITLE=Subtrack
APP_ENV=production
JWT_SECRET=5HqZUEi7801AYH1Vmv3HXD3SovIg1TNfjoRCCJ7e8oHAVJfmqFzOijgY6fnzzVj_
PORT=3000

# Database connection string:
# - On Render: Auto-configured from Render's managed PostgreSQL database.
# - Local runs: Leave empty to fall back to SQLite automatically, or point to local PostgreSQL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db

# Optional frontend customization (leave empty to use unified relative /api/v1 routing)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Subtrack